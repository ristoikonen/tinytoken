{
  "name": "tinytoken",
  "version": "2.0.0",
  "description": "High-Speed 25KB GF(2^8) Reed-Solomon, VQ 16x16 & SHARK/SNARK Compressed Token Indexer and Fast Image Viewer on Bun",
  "main": "server.ts",
  "module": "server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot server.ts",
    "start": "bun run server.ts",
    "test": "bun test",
    "build:windows": "bun build --compile --target=bun-windows-x64 ./server.ts --outfile ./tinytoken.exe"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@hyzyla/pdfium": "^3.0.0",
    "onnxruntime-node": "^1.31.1",
    "sharp": "^0.35.5"
  }
}
