{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.4.x",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "temp/data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/[...all]"
    }
  ]
}